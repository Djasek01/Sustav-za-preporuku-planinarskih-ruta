CREATE INDEX ruta_id IF NOT EXISTS FOR (r:Ruta) ON (r.id);
CREATE INDEX ruta_naziv IF NOT EXISTS FOR (r:Ruta) ON (r.naziv);
CREATE INDEX ruta_tezina IF NOT EXISTS FOR (r:Ruta) ON (r.tezina);
CREATE INDEX kt_naziv IF NOT EXISTS FOR (kt:KontrolnaTocka) ON (kt.naziv);
CREATE INDEX lokacija_naziv IF NOT EXISTS FOR (l:Lokacija) ON (l.naziv);
CREATE INDEX podrucje_naziv IF NOT EXISTS FOR (p:PodručjeHPO) ON (p.naziv);
CREATE INDEX oprema_naziv IF NOT EXISTS FOR (o:Oprema) ON (o.naziv);
CREATE INDEX dobna_naziv IF NOT EXISTS FOR (d:DobnaSkupina) ON (d.naziv);
CREATE INDEX vremenski_naziv IF NOT EXISTS FOR (v:VremenskiUvjet) ON (v.naziv);